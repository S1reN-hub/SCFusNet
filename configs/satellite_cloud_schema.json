  "cloud_feature_channels": {
    "version": "1.0",
    "description": "Five native GOES cloud-property channels; availability is retained independently for every pixel and channel",
    "dqf_policy": "Finite in-range COD/CPS retrievals are retained when DQF is degraded; strict-good DQF fraction is stored separately for scan weighting and audit. Other products require strict-good DQF.",
    "channels": [
      { "index": 0, "name": "COD", "description": "Cloud Optical Depth", "fill_value": null, "validity_mask_required": true },
      { "index": 1, "name": "cloud_fraction", "description": "Per-pixel cloud indicator (0=valid clear, 1=valid cloudy)", "fill_value": null, "validity_mask_required": true },
      { "index": 2, "name": "cloud_top_pressure_hpa", "description": "Cloud top pressure (hPa)", "fill_value": null, "validity_mask_required": true },
      { "index": 3, "name": "CER_liq_um", "description": "Cloud effective radius, liquid/supercooled phase (um)", "fill_value": null, "validity_mask_required": true },
      { "index": 4, "name": "CER_ice_um", "description": "Cloud effective radius, ice phase (um)", "fill_value": null, "validity_mask_required": true }
    ]
  },
