      "full_disk_resolution_km": 2,
      "full_disk_pixels": 5424,
      "pixel_radian": 5.6e-5,
      "products": {
        "CloudMask": {
          "aws_prefix": "ABI-L2-ACMF",
          "description": "Clear Sky Mask (not cloud phase)",
          "resolution_km": 2,
          "variables": {
            "BCM": { "long_name": "Binary Cloud Mask", "values": { "0": "clear", "1": "cloudy" } },
            "ACM": { "long_name": "Four-level Cloud Mask", "values": { "0": "clear", "1": "probably_clear", "2": "probably_cloudy", "3": "cloudy" } }
          },
          "quality_fields": ["DQF"]
        },
        "COD": {
          "aws_prefix": "ABI-L2-CODF",
          "description": "Cloud Optical Depth (Full Disk)",
          "resolution_km": 2,
          "variables": {
            "COD": {
              "long_name": "Cloud Optical Depth",
              "units": "dimensionless",
              "valid_range": [0, 100],
              "fill_value": -1.0
            }
          },
          "quality_fields": ["DQF", "COD_Retrieval_Flag"],
          "sza_limit_deg": 70.0
        },
        "Phase": {
          "aws_prefix": "ABI-L2-ACTPF",
          "description": "Cloud Top Phase (Full Disk)",
          "resolution_km": 10,
          "variables": {
            "Phase": {
              "long_name": "Cloud Phase Classification",
              "values": {
                "0": "Clear",
                "1": "Water",
                "2": "Supercooled",
                "3": "Mixed",
                "4": "Ice",
                "5": "Unknown"
              }
            }
          }
        },
        "CTP": {
          "aws_prefix": "ABI-L2-ACHP2KMF",
          "description": "Enterprise 2 km Cloud Top Pressure (optional; AWS archive starts in 2023)",
          "resolution_km": 2,
          "variables": {
            "PRES": {
              "long_name": "Cloud Top Pressure",
              "units": "hPa",
              "valid_range": [0, 1100]
            }
          },
          "quality_fields": ["DQF"]
        },
        "CPS": {
          "aws_prefix": "ABI-L2-CPSF",
          "description": "Cloud Particle Size / effective radius (Full Disk, optional in the first ablation)",
          "resolution_km": 2,
          "variables": {
            "CPS": {
              "long_name": "Cloud Particle Effective Radius",
              "units": "micrometers",
              "valid_range": [0, 160]
            },
            "PSD": {
              "long_name": "Legacy GOES-R Cloud Particle Size alias",
              "units": "micrometers",
              "valid_range": [0, 160]
            }
          },
          "quality_fields": ["DQF"]
        }
      }
