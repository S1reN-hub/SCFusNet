&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '{{START_DATE}}','{{START_DATE}}',
 end_date   = '{{END_DATE}}','{{END_DATE}}',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, 30,
 j_parent_start    = 1, 30,
 e_we              = 100, 124,
 e_sn              = 100, 124,
 geog_data_res     = 'albedo_ncep+maxsnowalb_ncep+default','albedo_ncep+maxsnowalb_ncep+default',
 dx = 9000,
 dy = 9000,
 map_proj  = 'mercator',
 ref_lat   = {{REF_LAT}},
 ref_lon   = {{REF_LON}},
 truelat1  = {{REF_LAT}},
 stand_lon = {{REF_LON}},
 geog_data_path = '{{GEOG_DATA_PATH}}',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/
